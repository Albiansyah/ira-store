generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// --- TABEL ASLI SUPABASE (CONVERTED) ---

model Product {
  id                 String      @id @default(uuid())
  name               String
  slug               String?     @unique
  description        String?     @db.Text
  price              Int
  unitCount          Int         @map("unit_count")
  isActive           Boolean     @default(true) @map("is_active")
  productType        String      @default("gmail") @map("product_type") // gmail, ebook, app, template
  fileUrl            String?     @map("file_url")
  discountPrice      Int?        @map("discount_price")
  discountPercentage Int?        @map("discount_percentage")
  finalPrice         Int         @map("final_price")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  
  orderItems         OrderItem[]

  @@map("products")
}

model Order {
  id               String      @id @default(uuid())
  buyerEmail       String      @map("buyer_email")
  buyerPhone       String      @map("buyer_phone")
  status           String      @default("pending") // pending, paid, completed, cancelled
  paymentReference String?     @map("payment_reference")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  
  // Relasi ke Affiliate (Fitur Baru)
  affiliateId      String?     @map("affiliate_id")
  affiliate        Affiliate?  @relation(fields: [affiliateId], references: [id])

  orderItems       OrderItem[]
  whatsappLogs     WhatsappLog[]

  @@map("orders")
}

model OrderItem {
  id                 String         @id @default(uuid())
  orderId            String         @map("order_id")
  productId          String         @map("product_id")
  quantity           Int            @default(1)
  unitPrice          Int            @map("unit_price")
  totalPrice         Int            @map("total_price")
  effectiveUnitCount Int            @map("effective_unit_count")
  createdAt          DateTime       @default(now()) @map("created_at")
  
  order              Order          @relation(fields: [orderId], references: [id])
  product            Product        @relation(fields: [productId], references: [id])
  accountsStock      AccountsStock[]

  @@map("order_items")
}

model AccountsStock {
  id                  String     @id @default(uuid())
  username            String
  password            String
  meta                Json?
  isUsed              Boolean    @default(false) @map("is_used")
  assignedOrderItemId String?    @map("assigned_order_item_id")
  createdAt           DateTime   @default(now()) @map("created_at")

  orderItem           OrderItem? @relation(fields: [assignedOrderItemId], references: [id])

  @@map("accounts_stock")
}

model AppSettings {
  key       String   @id
  value     Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

model WhatsappLog {
  id          Int      @id @default(autoincrement())
  orderId     String?  @map("order_id")
  toNumber    String   @map("to_number")
  message     String   @db.Text
  status      String
  responseRaw Json?    @map("response_raw")
  createdAt   DateTime @default(now()) @map("created_at")

  order       Order?   @relation(fields: [orderId], references: [id])

  @@map("whatsapp_logs")
}

// --- TABEL BARU: SISTEM AFFILIATE ---

model Affiliate {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  whatsapp     String
  referralCode String      @unique @map("referral_code")
  balance      Int         @default(0)
  status       String      @default("active") // active, banned
  createdAt    DateTime    @default(now()) @map("created_at")
  
  orders       Order[]
  withdrawals  Withdrawal[]

  @@map("affiliates")
}

model Withdrawal {
  id          String    @id @default(uuid())
  affiliateId String    @map("affiliate_id")
  amount      Int
  status      String    @default("pending") // pending, processed, rejected
  bankDetails String    @map("bank_details") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  @@map("withdrawals")
}